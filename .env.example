# ============================================================
# Apply Backend - Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# NE JAMAIS commiter le fichier .env sur Git !
# ============================================================

# Base de donnees PostgreSQL
# Format : postgresql://utilisateur:motdepasse@hote:port/nom_bdd
DATABASE_URL=postgresql://postgres:motdepasse@localhost:5432/cvgen_db

# Cle secrete JWT (generer avec : openssl rand -hex 32)
SECRET_KEY=changez_cette_cle_par_une_valeur_aleatoire_longue

# Algorithme JWT (ne pas modifier)
ALGORITHM=HS256

# Duree de validite du token en minutes (60 = 1 heure)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Chaine de fournisseurs d'IA, essayes dans l'ordre : si l'un n'a pas de cle, est en panne ou
# a epuise son quota gratuit, le suivant repond. Valeurs : gemini, groq, openrouter, mistral, ollama, anthropic
LLM_PROVIDERS=gemini,groq,openrouter,mistral

# Google Gemini - cle gratuite sur https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Modeles de secours essayes dans l'ordre si le principal est surcharge
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.8-flash

# Groq - cle gratuite sur https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# OpenRouter - cle gratuite sur https://openrouter.ai/keys (modeles ":free", liste changeante)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b:free

# Mistral - palier gratuit sur https://console.mistral.ai
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Ollama - modele local sans cle ni quota (https://ollama.com), a ajouter a LLM_PROVIDERS
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Anthropic Claude - payant, https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Origines autorisees par CORS, separees par des virgules
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Comptes -----------------------------------------------------------------
# URL du frontend, utilisee dans les liens envoyes par email
FRONTEND_URL=http://localhost:5173
# Les fonctions IA exigent un email confirme (mettre false uniquement pour des tests)
REQUIRE_EMAIL_VERIFICATION=true

# Emails : "console" ecrit le message (avec le lien) dans le terminal du backend, pratique en local.
# "brevo" envoie par l'API de Brevo (HTTPS) : indispensable sur l'offre gratuite de Render, qui bloque les ports SMTP.
# "smtp" envoie par SMTP : Gmail (mot de passe d'application), Mailgun...
MAIL_BACKEND=console
MAIL_FROM=Apply <no-reply@votre-domaine.com>
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# Connexion Google (optionnel) : ID client OAuth "Application Web" de Google Cloud Console,
# avec http://localhost:5173 dans les origines JavaScript autorisees
GOOGLE_CLIENT_ID=

# Adresse du support (Repondre a des emails, messages de securite, pages legales)
SUPPORT_EMAIL=

# --- Plans et quotas mensuels (candidatures generees, offres analysees, CV importes) ---
FREE_GENERATIONS=3
FREE_ANALYSES=10
FREE_IMPORTS=3
PRO_GENERATIONS=50
PRO_ANALYSES=150
PRO_IMPORTS=20

# --- Stripe : cartes bancaires, abonnement mensuel (https://dashboard.stripe.com/test/apikeys) ---
# Cle secrete de TEST (sk_test_...) pendant le developpement
STRIPE_SECRET_KEY=
# Secret du webhook (whsec_...) : "stripe listen --forward-to localhost:8000/billing/stripe/webhook" en local
STRIPE_WEBHOOK_SECRET=
# Optionnel : prix cree dans Stripe ; sinon les prix ci-dessous (en centimes) sont utilises
STRIPE_PRICE_ID=
PRO_STRIPE_PRICES=eur:799,usd:899,gbp:699
# TVA automatique : activer Stripe Tax dans le tableau de bord avant de passer a true
STRIPE_AUTOMATIC_TAX=false

# --- Flutterwave : MTN Mobile Money, Orange Money (https://app.flutterwave.com > Settings > API keys) ---
# Cle secrete de TEST (FLWSECK_TEST-...) pendant le developpement
FLUTTERWAVE_SECRET_KEY=
# "Secret hash" defini dans Settings > Webhooks (URL : https://votre-api/billing/momo/webhook)
FLUTTERWAVE_WEBHOOK_HASH=
# Pass Pro paye en une fois : prix par devise (FCFA CEMAC / UEMOA) et duree en jours
MOMO_PRICES=XAF:3000,XOF:3000
MOMO_DAYS=30
