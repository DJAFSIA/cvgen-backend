# ============================================================
# CVGen Backend - Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# NE JAMAIS commiter le fichier .env sur Git !
# ============================================================

# Base de donnees PostgreSQL
# Format : postgresql://utilisateur:motdepasse@hote:port/nom_bdd
DATABASE_URL=postgresql://postgres:motdepasse@localhost:5432/cvgen_db

# Cle secrete JWT (generer avec : openssl rand -hex 32)
SECRET_KEY=changez_cette_cle_par_une_valeur_aleatoire_longue

# Algorithme JWT (ne pas modifier)
ALGORITHM=HS256

# Duree de validite du token en minutes (60 = 1 heure)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Fournisseur du modele de langage : gemini (gratuit), groq (gratuit) ou anthropic (payant)
LLM_PROVIDER=gemini

# Google Gemini - cle gratuite sur https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Modeles de secours essayes dans l'ordre si le principal est surcharge
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.8-flash

# Groq - cle gratuite sur https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic Claude - payant, https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Origines autorisees par CORS, separees par des virgules
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Comptes -----------------------------------------------------------------
# URL du frontend, utilisee dans les liens envoyes par email
FRONTEND_URL=http://localhost:5173
# Les fonctions IA exigent un email confirme (mettre false uniquement pour des tests)
REQUIRE_EMAIL_VERIFICATION=true

# Emails : "console" ecrit le message (avec le lien) dans le terminal du backend, pratique en local.
# "smtp" envoie vraiment : Gmail (mot de passe d'application), Brevo, Resend, Mailgun...
MAIL_BACKEND=console
MAIL_FROM=CVGen <no-reply@votre-domaine.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# Connexion Google (optionnel) : ID client OAuth "Application Web" de Google Cloud Console,
# avec http://localhost:5173 dans les origines JavaScript autorisees
GOOGLE_CLIENT_ID=
